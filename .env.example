# Copy this file to `.env` and fill in your values.
# ALL VARIABLES ARE OPTIONAL — the screener only reads public endpoints in MVP,
# so API keys are not required to run live mode.

# Binance USDM credentials (optional — public endpoints work without them)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# How many rows to print in the top table (default 20)
SCREENER_TOP_N=20

# How many 1-minute candles to request per symbol (default 90)
SCREENER_CANDLE_LIMIT=90

# How many of the most liquid USDM perpetuals to scan (ranked by 24h quote volume)
SCREENER_UNIVERSE_LIMIT=40

# Logging verbosity: DEBUG / INFO / WARNING / ERROR (default INFO)
SCREENER_LOG_LEVEL=INFO

# --- TradingView report -----------------------------------------------------
# Set to false / 0 / no to skip writing the HTML report
GENERATE_TRADINGVIEW_REPORT=true
# Exchange prefix used in the TradingView ticker (BINANCE, BYBIT, ...)
TRADINGVIEW_EXCHANGE_PREFIX=BINANCE
# Default interval. Examples: "1", "5", "15", "60", "240", "D"
TRADINGVIEW_INTERVAL=60
# Where to write the HTML report
TRADINGVIEW_REPORT_PATH=data/processed/tradingview_report.html

# --- Signal quality ---------------------------------------------------------
# Reference funding rate (raw, not %) used to compute funding_pressure.
# Funding pressure = abs(funding_rate) / SIGNAL_FUNDING_ABS_THRESHOLD.
# 0.0003 (~0.03%) is the typical "elevated" threshold on Binance USDM.
SIGNAL_FUNDING_ABS_THRESHOLD=0.0003

# --- Signal Memory (history + outcome evaluation) ---------------------------
# Master switch. false/0/no disables recording + evaluation entirely.
SIGNAL_HISTORY_ENABLED=true
# Where the SQLite history DB, HTML report and CSV export live.
SIGNAL_HISTORY_DB_PATH=data/signals/signal_history.db
SIGNAL_HISTORY_REPORT_PATH=data/processed/signal_history_report.html
SIGNAL_HISTORY_EXPORT_PATH=data/signals/exports/signal_history.csv

# De-dup / quality gate for *recording* a new signal.
SIGNAL_HISTORY_COOLDOWN_MINUTES=60
SIGNAL_HISTORY_MIN_SCORE=60
SIGNAL_HISTORY_MIN_QUALITY=50

# Per-horizon "match" thresholds (% move in the expected direction).
SIGNAL_MATCH_15M_PCT=0.5
SIGNAL_MATCH_1H_PCT=1.0
SIGNAL_MATCH_4H_PCT=2.0
SIGNAL_MATCH_24H_PCT=3.0

# How long to keep history before retention prunes it (days).
SIGNAL_HISTORY_RETENTION_DAYS=180
